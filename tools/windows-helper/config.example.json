{
  "app_base_url": "http://localhost:3000",
  "app_api_token": "<APP_API_TOKEN>",
  "chrome_executable_path": "<CHROME_EXECUTABLE_PATH>",
  "work_root": "./work",
  "flow_accounts": {
    "FLOW-EXAMPLE": {
      "lanes": [
        {
          "lane_key": "utama",
          "label": "Profil utama",
          "chrome_profile_path": "<CHROME_PROFILE_PATH_MAIN>",
          "active": true
        },
        {
          "lane_key": "cadangan",
          "label": "Profil cadangan",
          "chrome_profile_path": "<CHROME_PROFILE_PATH_BACKUP>",
          "active": false
        }
      ]
    }
  },
  "output_folders": {
    "default": "<LOCAL_OUTPUT_FOLDER_PATH>"
  },
  "google_oauth": {
    "client_id": "<GOOGLE_OAUTH_CLIENT_ID>",
    "client_secret": "<GOOGLE_OAUTH_CLIENT_SECRET>",
    "refresh_token": "<GOOGLE_OAUTH_REFRESH_TOKEN>"
  }
}
